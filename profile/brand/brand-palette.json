{
  "name": "AI SAFE EARTH",
  "version": "3.0.0",
  "direction": "hi-vis / vector",
  "core": {
    "yellow": { "hex": "#E6FF00", "role": "brand, action, +, code front" },
    "ink":    { "hex": "#0A0A0A", "role": "text, code, default ground" },
    "paper":  { "hex": "#F4F4EF", "role": "reading ground" },
    "white":  { "hex": "#FFFFFF", "role": "alternate light ground" }
  },
  "signals": {
    "red":    { "hex": "#FF3B30", "role": "risk / finding only, −", "ground": false },
    "blue":   { "hex": "#2D4BFF", "role": "decision-makers front, RESEARCH branch", "onInk": "#7C8BFF" },
    "violet": { "hex": "#7B3CFF", "role": "street front, COMMUNICATE branch", "onInk": "#A98BFF" }
  },
  "neutrals": {
    "line": "#2A2A2A",
    "grey": "#3A3A36",
    "subOnInk": "#BDBDB5",
    "mutedOnInk": "#A8A8A0"
  },
  "fronts": {
    "STREET": "#7B3CFF",
    "CODE": "#E6FF00",
    "DECISION_MAKERS": "#2D4BFF"
  },
  "branches": {
    "BUILD": "#E6FF00",
    "RESEARCH": "#2D4BFF",
    "COMMUNICATE": "#7B3CFF"
  },
  "badges": {
    "labelColor": "0A0A0A",
    "style": "flat-square",
    "chips": { "DONE": "3A3A36", "ACTIVE": "3A3A36", "OPEN": "3A3A36", "RISK": "FF3B30" },
    "links": "2D4BFF",
    "umbrella": "0A0A0A"
  },
  "rule": "yellow + ink + at most one signal per view"
}
